# 在线模式必需；仅填到本地 .env（本程序不会自动读取）或 GitHub Secrets
DEEPSEEK_API_KEY=
PUSHPLUS_TOKEN=

# OpenAI-compatible API
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_REVIEW_MODEL=deepseek-v4-pro

# PushPlus 必须显式改为 true 才会真实发送
PUSHPLUS_ENABLED=false
PUSHPLUS_TOPIC=
PUSHPLUS_CALLBACK_URL=
SITE_BASE_URL=
